extern "C" %{
/*
 * Copyright (c) 2010-2022 The University of Tennessee and The University
 *                         of Tennessee Research Foundation. All rights
 *                         reserved.
 * Copyright (c) 2013      Inria. All rights reserved.
 *
 * @precisions normal z -> s d c
 *
 */
#include "dplasma/config.h"
#if defined(DPLASMA_HAVE_CUDA)
#include <cublas.h>
#endif  /* defined(DPLASMA_HAVE_CUDA) */
#include "dplasmajdf.h"
#include "parsec/data_dist/matrix/matrix.h"

/* Define the different shapes this JDF is using */
#define A_SHAPE 0
#define B_SHAPE 1

/* Assume the functions on type & type_remote will return parsec_arena_datatype_t */
#define JDF2C_TYPE_ADT_NOT_INDEX

/* Include the functions to obtain the parsec_arena_datatype_t */
#include "dplasmajdf_lapack_dtt.h"
//#define FULL_CONVERSION
#ifdef FULL_CONVERSION
#define ADTT_READ(dM, loc, shape, layout) ADTT_DC(dM, loc, shape, layout)
#else
#define ADTT_READ(dM, loc, shape, layout) ADTT_DC(dM, loc, shape, LAPACK)
#endif

/* Note: with this approach to support LAPACK format and minimize
 * the number of tile conversions performed, it is critical to
 * determined the correct location on the matrix where the tile was
 * originated from.
 * Note that the LOC parameters do not correspond to the binding of the
 * task to the matrix (although sometimes they match). These parameters
 * correspond to the location were the datacopy was originate on the matrix (maybe
 * it was read on another task).
 * If there is no possibility to determine it (datacopy passed along multiple
 * tasks and that information is lost) the approach is to force a reshapping.
 *
 */

/* Checksums of what every task actually sees at its entry, recorded into
 * parsec's in-memory debug history: printing them would serialize the run and
 * hide the corruption we are chasing. Each record names the tile of the
 * original matrix the copy came from, so a value that a producer wrote and a
 * consumer disagrees about is a straight string comparison in the dump.
 * Only the tile's live elements are hashed, at its real leading dimension,
 * so the padding a tile carries around never enters the result. */
#if defined(PARSEC_DEBUG_HISTORY)
#include <inttypes.h>
#include <stdlib.h>
#include <string.h>

static inline uint64_t trmm_tile_hash( const void *ptr, int m, int n, int ld )
{
    const char *base = (const char*)ptr;
    size_t es = sizeof(dplasma_complex64_t), col = (size_t)m * es;
    uint64_t h = 14695981039346656037ULL;
    int j;

    for( j = 0; j < n; j++ ) {
        const char *p = base + (size_t)j * ld * es;
        size_t i = 0;
        for( ; i + sizeof(uint64_t) <= col; i += sizeof(uint64_t) ) {
            uint64_t w;
            memcpy(&w, p + i, sizeof(uint64_t));
            h = (h ^ w) * 1099511628211ULL;
        }
        for( ; i < col; i++ )
            h = (h ^ (uint64_t)(unsigned char)p[i]) * 1099511628211ULL;
    }
    return h;
}
#define TRMM_HASH(ptr, m, n, ld) trmm_tile_hash(ptr, m, n, ld)
#define TRMM_COL(ptr, c, ld) \
    ((const void*)((const char*)(ptr) + \
                   (size_t)(c) * (ld) * sizeof(dplasma_complex64_t)))
#define TRMM_BANDS 4

/* A copy of the output tile taken before the kernel runs, so the same kernel
 * can be run over it a second time once the first call has returned. Two
 * calls with the same operands owe the same answer, so a redo that agrees
 * with the other iterations while the tile in place does not says the bytes
 * changed after the kernel wrote them rather than the kernel computing them
 * differently. Off unless TRMM_REDO is set: the second call doubles the
 * kernel time and moves the race it is meant to observe. */
static inline int trmm_redo_on( void )
{
    static int on = -1;
    if( on < 0 ) on = (NULL != getenv("TRMM_REDO"));
    return on;
}

static inline void *trmm_tile_save( const void *ptr, int m, int n, int ld )
{
    size_t es = sizeof(dplasma_complex64_t);
    char *copy;
    int j;

    if( !trmm_redo_on() ) return NULL;
    if( NULL == (copy = malloc((size_t)m * n * es)) ) return NULL;
    for( j = 0; j < n; j++ )
        memcpy(copy + (size_t)j * m * es,
               (const char*)ptr + (size_t)j * ld * es, (size_t)m * es);
    return copy;
}
#define TRMM_SAVE(ptr, m, n, ld) trmm_tile_save(ptr, m, n, ld)
#else
#define TRMM_HASH(ptr, m, n, ld) ((uint64_t)0)
#define TRMM_COL(ptr, c, ld) (ptr)
#define TRMM_BANDS 0
#define TRMM_SAVE(ptr, m, n, ld) NULL
#endif  /* defined(PARSEC_DEBUG_HISTORY) */

%}

side      [type = "dplasma_enum_t"]
uplo      [type = "dplasma_enum_t"]
trans     [type = "dplasma_enum_t"]
diag      [type = "dplasma_enum_t"]
alpha     [type = "dplasma_complex64_t"]

ddescA     [type = "dplasma_data_collection_t*"]
descA      [type = "const parsec_tiled_matrix_t*" hidden = on default = "((dplasma_data_collection_t*)ddescA)->dc_original" aligned=ddescA]

ddescB     [type = "dplasma_data_collection_t*"]
descB      [type = "parsec_tiled_matrix_t*" hidden = on default = "((dplasma_data_collection_t*)ddescB)->dc_original" aligned=ddescB]

hip_handles_infokey     [type = "int" hidden = on default = -1 ]

read_A(n, k) [profile = off]
  /* Execution Space */
  n = 0 .. (descB->nt-1)
  k = 0 .. (descB->nt-n-1)

loc_A = %{ return LOC(descA, (descB->nt-1)-n, k); %}

  /* Locality */
  : descA((descB->nt-1)-n, k)

  READ  A    <- ddescA((descB->nt-1)-n, k)                               [ type        = %{ return ADTT_READ(ddescA, loc_A, A_SHAPE, TILED); %}
                                                                           type_data   = %{ return ADTT_READ(ddescA, loc_A, A_SHAPE, LAPACK); %} ]
             -> (k == (descB->nt-1-n)) ? A ztrmm(n, 0..(descB->mt-1))    /* dep OUT: rely on datacopy dtt for sending */
             -> (k != (descB->nt-1-n)) ? B zgemm(n, 0..(descB->mt-1), k) /* dep OUT: rely on datacopy dtt for sending */

BODY
{
    parsec_debug_history_add("TILEHASH r%d descA(%d,%d) read_A(%d,%d) %016"PRIx64" @%p\n",
                             descB->super.myrank, (descB->nt-1)-n, k, n, k,
                             TRMM_HASH(A, CLEAN_MB(descA, (descB->nt-1)-n),
                                          CLEAN_NB(descA, k), LDA(ddescA, A)), (void*)A);
}
END

read_B(m, k) [profile = off]
  /* Execution Space */
  m = 0 .. (descB->mt-1)
  k = 0 .. (descB->nt-1)

loc_B = %{ return LOC(descB, m, k); %}

  /* Locality */
  : descB(m,k)

  /* The sole entry point into the DAG for every tile of B. ztrmm((nt-1)-k, m)
   * overwrites this very tile, so it takes it from here rather than reading
   * ddescB a second time: a tile with two entry points is not something the
   * runtime can relate, and the two views then race.
   * Column nt-1 feeds no zgemm, so that output is conditional. */
  READ  B    <- ddescB(m,k)                         [ type        = %{ return ADTT_READ(ddescB, loc_B, B_SHAPE, TILED); %}
                                                      type_data   = %{ return ADTT_READ(ddescB, loc_B, B_SHAPE, LAPACK); %} ]
             -> (k <= (descB->nt-2)) ? A zgemm(0 .. (descB->nt-k-2), m, k) /* dep OUT: rely on datacopy dtt for sending */
             -> B ztrmm((descB->nt-1)-k, m)         /* dep OUT: rely on datacopy dtt for sending */

BODY
{
    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) read_B(%d,%d) %016"PRIx64" @%p\n",
                             descB->super.myrank, m, k, m, k,
                             TRMM_HASH(B, CLEAN_MB(descB, m), CLEAN_NB(descB, k),
                                          LDA(ddescB, B)), (void*)B);
}
END

ztrmm(n, m) [ flops = inline_c %{ return FLOPS_ZTRMM(side, CLEAN_MB(descB, m), CLEAN_NB(descB, n)); %} ]
  /* Execution Space */
  n = 0 .. (descB->nt-1)
  m = 0 .. (descB->mt-1)

loc_A = %{ return LOC(descA, (descB->nt-1)-n,(descB->nt-1)-n); %}
loc_B = %{ return LOC(descB, m,             (descB->nt-1)-n); %}

  /* Locality */
  : descB(m,(descB->nt-1)-n)

  CTL   ctl0 <- ctl0 zgemm(0..n-1, m, descB->nt-n-1)
  READ  A    <- A read_A(n, descB->nt-1-n)                          [ type_remote = %{ return ADTT_DC(ddescA, loc_A, A_SHAPE, TILED); %} ]
  /* B enters the DAG only through read_B, exactly as A enters only
   * through read_A. */
  RW    B    <- B read_B(m,(descB->nt-1)-n)                         [ type_remote = %{ return ADTT_DC(ddescB, loc_B, B_SHAPE, TILED); %} ]
             -> (n <  (descB->nt-1)) ? C zgemm(n, m, 0)             /* dep OUT: rely on datacopy dtt for sending */
             -> (n == (descB->nt-1)) ? ddescB( m, (descB->nt-1)-n ) [ type        = %{ return ADTT_CP(_f_B, ddescB, loc_B, B_SHAPE); %}
                                                                      type_data   = %{ return ADTT_DC(ddescB, loc_B, B_SHAPE, LAPACK); %} ]

BODY
{
    int tempmm = ((m)==(descB->mt-1)) ? (descB->m-(m*descB->mb)) : descB->mb;
    int tempnn = (((descB->nt-1)-n)==(descB->nt-1)) ? (descB->n-(((descB->nt-1)-n)*descB->nb)) : descB->nb;
    int lda = LDA(ddescA, A);
    int ldb = LDA(ddescB, B);
    void *redo;

    printlog("CORE_ztrmm(%d, %d)\n"
             "\t(side, uplo, trans, diag, tempmm, tempnn, alpha, A(%d,%d)[%p], lda, B(%d,%d)[%p], ldb)\n",
             n, m, (descB->nt-1)-n, (descB->nt-1)-n, A, m, (descB->nt-1)-n, B);

    parsec_debug_history_add("TILEHASH r%d descA(%d,%d) trmm(%d,%d).A %016"PRIx64" @%p\n",
                             descB->super.myrank, (descB->nt-1)-n, (descB->nt-1)-n, n, m,
                             TRMM_HASH(A, CLEAN_MB(descA, (descB->nt-1)-n),
                                          CLEAN_NB(descA, (descB->nt-1)-n), lda), (void*)A);
    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) trmm(%d,%d).B %016"PRIx64" @%p\n",
                             descB->super.myrank, m, (descB->nt-1)-n, n, m,
                             TRMM_HASH(B, tempmm, tempnn, ldb), (void*)B);

    redo = TRMM_SAVE(B, tempmm, tempnn, ldb);

    CORE_ztrmm(side, uplo, trans,
               diag, tempmm, tempnn,
               alpha, A /* descA((descB->nt-1)-n,(descB->nt-1)-n) */, lda,
                      B /* descB(m,             (descB->nt-1)-n) */, ldb );

    /* The operand hashed again now that the kernel is done with it. An input
     * that moved between the two readings was being written while the kernel
     * was reading it, which is a different failure from the output being
     * clobbered afterwards and wants a different fix. */
    parsec_debug_history_add("TILEHASH r%d descA(%d,%d) trmm(%d,%d).A-after %016"PRIx64" @%p\n",
                             descB->super.myrank, (descB->nt-1)-n, (descB->nt-1)-n, n, m,
                             TRMM_HASH(A, CLEAN_MB(descA, (descB->nt-1)-n),
                                          CLEAN_NB(descA, (descB->nt-1)-n), lda), (void*)A);
    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) trmm(%d,%d).out %016"PRIx64
                             " @%p mn=%d,%d ld=%d,%d\n",
                             descB->super.myrank, m, (descB->nt-1)-n, n, m,
                             TRMM_HASH(B, tempmm, tempnn, ldb), (void*)B,
                             tempmm, tempnn, lda, ldb);

    if( NULL != redo ) {
        CORE_ztrmm(side, uplo, trans, diag, tempmm, tempnn,
                   alpha, A, lda, redo, tempmm );
        parsec_debug_history_add("TILEHASH r%d descB(%d,%d) trmm(%d,%d).redo "
                                 "%016"PRIx64" @%p\n",
                                 descB->super.myrank, m, (descB->nt-1)-n, n, m,
                                 TRMM_HASH(redo, tempmm, tempnn, tempmm), (void*)B);
        free(redo);
    }
    {
        int q;
        for( q = 0; q < TRMM_BANDS; q++ ) {
            int c0 = (q * tempnn) / TRMM_BANDS, c1 = ((q+1) * tempnn) / TRMM_BANDS;
            if( c1 <= c0 ) continue;
            parsec_debug_history_add("TILEHASH r%d descB(%d,%d) trmm(%d,%d).out%d "
                                     "%016"PRIx64" @%p\n",
                                     descB->super.myrank, m, (descB->nt-1)-n, n, m, q,
                                     TRMM_HASH(TRMM_COL(B, c0, ldb), tempmm, c1-c0, ldb),
                                     (void*)B);
        }
    }
}
END

zgemm(n, m, k) [ flops = inline_c %{ return FLOPS_ZGEMM(CLEAN_MB(descB, m), CLEAN_NB(descB, n), descB->mb); %} ]
  /* Execution Space */
  n = 0 .. (descB->nt-2)
  m = 0 .. (descB->mt-1)
  k = 0 .. (descB->nt-n-2)

loc_A = %{ return LOC(descB, m,k); %}
loc_B = %{ return LOC(descA, (descB->nt-1)-n,k); %}
loc_C = %{ return LOC(descB, m,(descB->nt-1)-n); %}

  /* Locality */
  : descB(m,(descB->nt-1)-n)

  CTL   ctl0 -> ctl0 ztrmm(descB->nt-k-1, m)
  READ  A    <- B read_B(m, k)                                       [ type_remote = %{ return ADTT_DC(ddescB, loc_A, B_SHAPE, TILED); %} ]
  READ  B    <- A read_A(n, k)                                       [ type_remote = %{ return ADTT_DC(ddescA, loc_B, A_SHAPE, TILED); %} ]
  RW    C    <- (k >  0) ? C zgemm(n, m, k-1)                        [ type_remote = %{ return ADTT_DC(ddescB, loc_C, B_SHAPE, TILED); %} ]
             <- (k == 0) ? B ztrmm(n, m)                             [ type_remote = %{ return ADTT_DC(ddescB, loc_C, B_SHAPE, TILED); %} ]
             -> ((n+k) == (descB->nt-2)) ? ddescB(m,(descB->nt-1)-n) [ type        = %{ return ADTT_CP(_f_C, ddescB, loc_C, B_SHAPE); %}
                                                                       type_data   = %{ return ADTT_DC(ddescB, loc_C, B_SHAPE, LAPACK); %} ]
             -> ((n+k) <  (descB->nt-2)) ? C zgemm(n, m, k+1)         /* dep OUT: rely on datacopy dtt for sending */

BODY [type=CUDA]
{
#if defined(PRECISION_z) || defined(PRECISION_c)
    cuDoubleComplex lalpha = make_cuDoubleComplex(creal(alpha), cimag(alpha));
    cuDoubleComplex lbeta  = make_cuDoubleComplex( 1., 0.);
#else
    double lalpha = alpha;
    double lbeta = 1.0;
#endif
    int tempmm = ((m)==(descB->mt-1)) ? (descB->m-(m*descB->mb)) : descB->mb;
    int tempnn = (((descB->nt-1)-n)==(descB->nt-1)) ? (descB->n-(((descB->nt-1)-n)*descB->nb)) : descB->nb;
    int lda = LDA(ddescB, A);
    int ldb = LDA(ddescA, B);
    int ldc = LDA(ddescB, C);

    cublasStatus_t status;
    cublasSetKernelStream( parsec_body.stream );
    cublasZgemm( 'N', dplasma_lapack_const(trans),
                 tempmm, tempnn, descB->mb,
                 lalpha, (cuDoubleComplex*)A, lda,
                         (cuDoubleComplex*)B, ldb,
                 lbeta,  (cuDoubleComplex*)C, ldc );
    status = cublasGetError();
    PARSEC_CUDA_CHECK_ERROR( "cublasZgemm ", status, {return PARSEC_HOOK_RETURN_ERROR;} );
}
END

BODY [type=HIP]
{
#if defined(PRECISION_z) || defined(PRECISION_c)
    hipDoubleComplex lalpha = make_hipDoubleComplex(creal(alpha), cimag(alpha));
    hipDoubleComplex lbeta  = make_hipDoubleComplex( 1., 0.);
#else
    double lalpha = alpha;
    double lbeta = 1.0;
#endif
    int tempmm = ((m)==(descB->mt-1)) ? (descB->m-(m*descB->mb)) : descB->mb;
    int tempnn = (((descB->nt-1)-n)==(descB->nt-1)) ? (descB->n-(((descB->nt-1)-n)*descB->nb)) : descB->nb;
    int lda = LDA(ddescB, A);
    int ldb = LDA(ddescA, B);
    int ldc = LDA(ddescB, C);

    hipblasStatus_t status;
    dplasma_hip_handles_t *handles = parsec_info_get(&gpu_stream->infos, hip_handles_infokey);
    assert(NULL != handles);
    status = hipblasZgemm( handles->hipblas_handle, HIPBLAS_OP_N, dplasma_hipblas_op(trans),
                 tempmm, tempnn, descB->mb,
                 &lalpha, (hipDoubleComplex*)A, lda,
                         (hipDoubleComplex*)B, ldb,
                 &lbeta,  (hipDoubleComplex*)C, ldc );
    DPLASMA_HIPBLAS_CHECK_ERROR( "hipblasZgemm ", status, {return PARSEC_HOOK_RETURN_ERROR;} );
}
END

BODY
{
    int tempmm = ((m)==(descB->mt-1)) ? (descB->m-(m*descB->mb)) : descB->mb;
    int tempnn = (((descB->nt-1)-n)==(descB->nt-1)) ? (descB->n-(((descB->nt-1)-n)*descB->nb)) : descB->nb;
    int lda = LDA(ddescB, A);
    int ldb = LDA(ddescA, B);
    int ldc = LDA(ddescB, C);
    void *redo;

    printlog("CORE_zgemm(%d, %d, %d)\n"
             "\t(dplasmaNoTrans, trans, tempmm, tempnn, descB->mb, alpha, B(%d,%d)[%p], ldb, A(%d,%d)[%p], lda, 1.000000, B(%d,%d)[%p], ldb)\n",
             n, m, k, m, k, A, (descB->nt-1)-n, k, B, m, (descB->nt-1)-n, C);

    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) gemm(%d,%d,%d).A %016"PRIx64" @%p\n",
                             descB->super.myrank, m, k, n, m, k,
                             TRMM_HASH(A, CLEAN_MB(descB, m), CLEAN_NB(descB, k), lda), (void*)A);
    parsec_debug_history_add("TILEHASH r%d descA(%d,%d) gemm(%d,%d,%d).B %016"PRIx64" @%p\n",
                             descB->super.myrank, (descB->nt-1)-n, k, n, m, k,
                             TRMM_HASH(B, CLEAN_MB(descA, (descB->nt-1)-n),
                                          CLEAN_NB(descA, k), ldb), (void*)B);
    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) gemm(%d,%d,%d).C %016"PRIx64" @%p\n",
                             descB->super.myrank, m, (descB->nt-1)-n, n, m, k,
                             TRMM_HASH(C, tempmm, tempnn, ldc), (void*)C);

    redo = TRMM_SAVE(C, tempmm, tempnn, ldc);

    CORE_zgemm(dplasmaNoTrans, trans, tempmm, tempnn, descB->mb,
               alpha, A /* descB(m,k) */, lda,
                      B /* descA((descB->nt-1)-n,k) */, ldb,
               1.0,   C /* descB(m,(descB->nt-1)-n) */, ldc );

    /* Both operands hashed again now that the kernel is done with them, so a
     * tile written while it was being read can be told from an output
     * clobbered after the fact. */
    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) gemm(%d,%d,%d).A-after %016"PRIx64" @%p\n",
                             descB->super.myrank, m, k, n, m, k,
                             TRMM_HASH(A, CLEAN_MB(descB, m), CLEAN_NB(descB, k), lda), (void*)A);
    parsec_debug_history_add("TILEHASH r%d descA(%d,%d) gemm(%d,%d,%d).B-after %016"PRIx64" @%p\n",
                             descB->super.myrank, (descB->nt-1)-n, k, n, m, k,
                             TRMM_HASH(B, CLEAN_MB(descA, (descB->nt-1)-n),
                                          CLEAN_NB(descA, k), ldb), (void*)B);
    /* The kernel's own arguments ride along with the result: a tile hashed at
     * one leading dimension and written at another, or a dimension that came
     * out short, corrupts exactly as quietly as a stray write does. */
    parsec_debug_history_add("TILEHASH r%d descB(%d,%d) gemm(%d,%d,%d).out %016"PRIx64
                             " @%p mnk=%d,%d,%d ld=%d,%d,%d\n",
                             descB->super.myrank, m, (descB->nt-1)-n, n, m, k,
                             TRMM_HASH(C, tempmm, tempnn, ldc), (void*)C,
                             tempmm, tempnn, descB->mb, lda, ldb, ldc);

    if( NULL != redo ) {
        CORE_zgemm(dplasmaNoTrans, trans, tempmm, tempnn, descB->mb,
                   alpha, A, lda,
                          B, ldb,
                   1.0,   redo, tempmm );
        parsec_debug_history_add("TILEHASH r%d descB(%d,%d) gemm(%d,%d,%d).redo "
                                 "%016"PRIx64" @%p\n",
                                 descB->super.myrank, m, (descB->nt-1)-n, n, m, k,
                                 TRMM_HASH(redo, tempmm, tempnn, tempmm), (void*)C);
        free(redo);
    }

    /* The same output again, a band of columns at a time. How much of the
     * tile moved says what moved it: one band means something wrote over
     * part of the buffer, every band means the arithmetic itself differed. */
    {
        int q;
        for( q = 0; q < TRMM_BANDS; q++ ) {
            int c0 = (q * tempnn) / TRMM_BANDS, c1 = ((q+1) * tempnn) / TRMM_BANDS;
            if( c1 <= c0 ) continue;
            parsec_debug_history_add("TILEHASH r%d descB(%d,%d) gemm(%d,%d,%d).out%d "
                                     "%016"PRIx64" @%p\n",
                                     descB->super.myrank, m, (descB->nt-1)-n, n, m, k, q,
                                     TRMM_HASH(TRMM_COL(C, c0, ldc), tempmm, c1-c0, ldc),
                                     (void*)C);
        }
    }
}
END
